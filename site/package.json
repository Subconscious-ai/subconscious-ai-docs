{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "pnpm run gen-api-docs && node scripts/write-revision.mjs && docusaurus build && node scripts/gen-llms-txt.mjs && node scripts/gen-agent-artifacts.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "pnpm run gen-api-docs && tsc",
    "test:release-proof": "node --test scripts/write-revision.test.mjs scripts/verify-production.test.mjs",
    "test:ci-contracts": "node --test scripts/ci-contracts.test.mjs",
    "check:migration-evidence": "node scripts/check-migration-evidence.mjs",
    "test:agent-source-contracts": "node --test scripts/agent-source-contracts.test.mjs",
    "sync-spec": "bash scripts/sync-spec.sh",
    "gen-api-docs": "docusaurus gen-api-docs all",
    "clean-api-docs": "docusaurus clean-api-docs all",
    "rebuild-api-docs": "pnpm run clean-api-docs && pnpm run gen-api-docs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-google-gtag": "^3.10.2",
    "@docusaurus/plugin-ideal-image": "^3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@docusaurus/theme-search-algolia": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@mdx-js/react": "^3.0.0",
    "@scalar/docusaurus": "^0.8.32",
    "clsx": "^2.0.0",
    "docusaurus-plugin-image-zoom": "^3.0.1",
    "docusaurus-plugin-openapi-docs": "^5.1.2",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-openapi-docs": "^5.1.2",
    "posthog-js": "^1.407.2",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.13.1"
}
